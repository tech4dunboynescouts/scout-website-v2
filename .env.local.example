# ── Sanity CMS ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# A read-only API token from sanity.io/manage → project → API → Tokens
# Used server-side only to query private leader data
SANITY_API_READ_TOKEN=your_sanity_read_token

# A write-enabled API token from sanity.io/manage → project → API → Tokens
# Used server-side to store form submissions in Sanity
SANITY_WRITE_TOKEN=your_sanity_write_token

# ── SMTP (Join Form Notifications) ────────────────────────────────────────────
# Account used to send form notification emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email_address
SMTP_PASS=your_email_password_or_app_password
# Optional override for sender address shown in the email
# SMTP_FROM=notifications@yourdomain.com

# Destination email addresses for each form type
YOUTH_NOTIFICATION_EMAIL=your_youth_destination@example.com
VOLUNTEER_NOTIFICATION_EMAIL=your_volunteer_destination@example.com
CONTACT_NOTIFICATION_EMAIL=your_contact_destination@example.com

# ── Google Sheets (Youth Application Export) ──────────────────────────────────
# Service account credentials from Google Cloud (JSON key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Target spreadsheet and range for appended youth submissions
YOUTH_APPLICATIONS_SHEET_ID=your_google_sheet_id
# Optional: defaults to "Youth Applications!A:P" if omitted
# YOUTH_APPLICATIONS_SHEET_RANGE=Youth Applications!A:P

# Target spreadsheet and range for appended adult volunteer submissions
VOLUNTEER_APPLICATIONS_SHEET_ID=your_google_sheet_id
# Optional: defaults to "Volunteer Applications!A:F" if omitted
# VOLUNTEER_APPLICATIONS_SHEET_RANGE=Volunteer Applications!A:F

# ── Auth.js (NextAuth v5) ──────────────────────────────────────────────────────
# Your production URL (no trailing slash). On Vercel, set this to your custom domain.
NEXTAUTH_URL=https://1stmeathdunboynescouts.ie

# Random secret — generate with: openssl rand -base64 32
AUTH_SECRET=your_random_secret_here

# Google OAuth credentials from console.cloud.google.com
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# ── Stripe (Leaders Portal Payments) ──────────────────────────────────────────
# Secret key used server-side for PaymentIntent creation
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Publishable key used by the embedded checkout UI in the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ── Site ───────────────────────────────────────────────────────────────────────
# Override the canonical site URL (optional — falls back to https://1stmeathdunboynescouts.ie)
# NEXT_PUBLIC_SITE_URL=https://1stmeathdunboynescouts.ie
